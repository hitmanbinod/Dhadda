#!/usr/bin/env bash
# Deploy the static PWA to Cloudflare Pages, then lock the Worker's CORS to
# the deployed Pages origin and redeploy it. Correct order:
#   1. ./scripts/deploy-sync                       (Worker first)
#   2. WORKER_URL=… ./scripts/deploy-web           (Pages, then Worker CORS)
#
# PAGES_URL can be supplied if the project name is unavailable; otherwise the
# default https://dhadda-web.pages.dev is used.
set -euo pipefail
cd "$(dirname "$0")/.."
: "${WORKER_URL:?set WORKER_URL to the deployed sync Worker URL}"

PAGES_PROJECT="${PAGES_PROJECT:-dhadda-web}"
PAGES_URL="${PAGES_URL:-https://${PAGES_PROJECT}.pages.dev}"

# Point the app and CSP at the real Worker without committing secrets.
cat > webapp/config.js <<EOF
// Generated by scripts/deploy-web - deployed Worker URL.
window.DHADDA_SYNC_URL = '$WORKER_URL';
EOF
python3 - "$WORKER_URL" <<'PY'
import pathlib, re, sys
url = sys.argv[1]
p = pathlib.Path('webapp/_headers')
s = p.read_text(encoding='utf-8')
s = re.sub(r"connect-src 'self' https://[^;]+;", f"connect-src 'self' {url};", s)
p.write_text(s, encoding='utf-8')
PY

npx --yes wrangler@latest pages deploy webapp --project-name "$PAGES_PROJECT"

# Now that the stable Pages URL exists, restrict the Worker to that origin.
PAGES_URL="$PAGES_URL" ./scripts/deploy-sync
echo "Deploy complete. Web: $PAGES_URL  Worker: $WORKER_URL"
