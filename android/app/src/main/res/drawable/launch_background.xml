<?xml version="1.0" encoding="utf-8"?>
<!-- Dhadda launch splash: app icon centered on the light background.
     Visible while the Flutter engine draws its first frame (worst case
     is the documented 60-90s first-launch dexopt on low-end devices). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item android:drawable="@mipmap/ic_launcher" android:gravity="center" />
</layer-list>
