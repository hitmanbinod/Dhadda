<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textColor="@color/widget_text" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:text="Sat, 5 Mangsir" android:textColor="@color/widget_muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/widget_badge_coral" android:gravity="center" android:text="+" android:textColor="@color/widget_tint_coral_fg" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Spent today" android:textColor="@color/widget_muted" android:textSize="11sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true" android:text="रू 2,000" android:textColor="@color/widget_text" android:textSize="26sp" android:textStyle="bold" />

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/widget_cta" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/widget_dot_coral" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:singleLine="true" android:text="Add expense  ›" android:textColor="@color/widget_tint_coral_fg" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
