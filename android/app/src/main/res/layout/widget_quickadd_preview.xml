<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_action_coral" android:gravity="center" android:orientation="horizontal" android:padding="4dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_badge_coral" android:gravity="center" android:text="−" android:textColor="@color/widget_tint_coral_fg" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:singleLine="true" android:text="Expense" android:textColor="@color/widget_tint_coral_fg" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/widget_action_mint" android:gravity="center" android:orientation="horizontal" android:padding="4dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_badge_mint" android:gravity="center" android:text="+" android:textColor="@color/widget_tint_mint_fg" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:singleLine="true" android:text="Income" android:textColor="@color/widget_tint_mint_fg" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/widget_action_slate" android:gravity="center" android:orientation="horizontal" android:padding="4dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_badge_slate" android:gravity="center" android:text="⇄" android:textColor="@color/widget_tint_slate_fg" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:singleLine="true" android:text="Lent" android:textColor="@color/widget_tint_slate_fg" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
